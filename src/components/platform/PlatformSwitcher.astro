---
import UIString from "~/components/UIString.astro"
import type { Platform } from "~/util"

export interface Props {
  lang: string
  platform: Platform
  slug: string
}

const { lang, platform, slug } = Astro.props
---

<div>
  {
    platform === "ios" ? null : (
      <a href={`/${lang}/ios/${slug}/`}>
        <UIString key="platform.switchToIOS" />
      </a>
    )
  }
  {
    platform === "android" ? null : (
      <a href={`/${lang}/android/${slug}/`}>
        <UIString key="platform.switchToAndroid" />
      </a>
    )
  }
</div>
